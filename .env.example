# ==========================================
# CultureVerse Environment Configuration
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Authentication
# Replace with a cryptographically secure 256-bit secret in production
JWT_SECRET=cultureverse-secure-jwt-secret-african-heritage-2026

# Database
# Default is zero-config high performance SQLite (cultureverse.db)
DATABASE_URL=file:./cultureverse.db

# Gemma AI Integration (Ask Your Roots)
# Provide your Gemini / Gemma inference API key or custom hosted endpoint URL
# If left empty, CultureVerse gracefully activates grounded local library mode
GEMMA_API_KEY=
GEMMA_ENDPOINT=

# ALATPay Payment Integration (Paid Cultural Courses & Workshops)
# Official documentation: https://alatpay.ng/
# Provide your live credentials to process real card/bank transactions
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
ALATPAY_SECRET_KEY=
ALATPAY_BASE_URL=https://api.alatpay.ng/v1

# Media Storage
# Adapter for oral histories, documents and textiles (local or cloud)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
